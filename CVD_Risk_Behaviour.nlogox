<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.3" snapToGrid="true">
  <code><![CDATA[extensions [csv table]

breed [people person]
undirected-link-breed [household-links household-link]
undirected-link-breed [friend-links friend-link]

globals [
  rewiring-events
  death-count          ;; cumulative count of agents removed by a simulated CVD event
  t_lag_months         ;; lag-time in ticks (months) before a behaviour's RR reaches full strength
  sex-probs           ;; list of [Sex Probability] rows from sex.csv
  age-dist-male        ;; list of 72 probabilities for ages 18..89, from age_distribution.csv
  age-dist-female
  employed-lookup      ;; table: key "Sex-Age" -> % employed (0-100), from employed.csv
  next-household-id    ;; NEW -- running counter so newly-formed households never collide with setup ids
  new-residents-count  ;; NEW -- cumulative count of agents added via add-new-residents (city inflow)
  annual_inflow         ;; NEW -- expected number of new 18+ adults added to the city per year.
                        ;;         Declared here as a plain global so the model works with no interface
                        ;;         changes. If you'd rather control it from a slider instead, delete this
                        ;;         line AND the "set annual_inflow 10" line below, then add a slider on
                        ;;         the Interface tab bound to a global called "annual_inflow" -- but not
                        ;;         both at once, NetLogo won't allow the same name declared twice.
  city-capacity         ;; NEW -- soft population ceiling (housing/resource limit). Inflow is throttled
                        ;;         once the city is at/near this size, same idea as any real city running
                        ;;         out of housing stock.
  monthly-outmigration-prob  ;; NEW -- baseline monthly chance ANY resident (any age) moves away from the
                        ;;         city for non-health reasons (job, family, relocation). This is the
                        ;;         second exit route a real city has besides death -- without it, healthy
                        ;;         young inflow just accumulates forever since they almost never die.
  out-migrant-count     ;; NEW -- cumulative count of agents removed via out-migration (kept separate
                        ;;         from death-count -- these agents didn't have a CVD event, they moved)
]

people-own [
  household-id
  sex                ;; "Male" / "Female"   -- sampled from sex.csv
  age                ;; integer 18-89       -- sampled from age_distribution.csv, conditional on sex
  age-months          ;; 0-11, counts months since last birthday (tick = month)
  employed?          ;; boolean             -- sampled from employed.csv, conditional on sex+age
                      ;;                        (IMD not yet modelled -- see note in load-parameters)
  smoking-level      ;; 0 = never smoked, 1 = ex-smoker, 2 = current smoker
  alcohol-level      ;; 0-2
  diet-level         ;; 0-2
  inactivity-level   ;; 0-2
  smoking-level-months     ;; consecutive ticks (months) spent at the CURRENT level -- drives t_lag ramp
  alcohol-level-months
  diet-level-months
  inactivity-level-months
  risk-score         ;; 0-8, sum of the four levels above (display/colour proxy only)
]

;; ================= PARAMETER LOADING (B.1 demographic attributes) =================
;; sex.csv, age_distribution.csv and employed.csv must sit in the same folder as this .nlogox

to load-parameters
  ;; ---- sex.csv : Sex,Probability ----
  set sex-probs but-first csv:from-file "sex.csv"

  ;; ---- age_distribution.csv : Sex,18,19,...,89  (P(age|sex), each row sums to ~1) ----
  foreach but-first csv:from-file "age_distribution.csv" [ row ->
    ifelse (item 0 row) = "Male"
      [ set age-dist-male but-first row ]
      [ set age-dist-female but-first row ]
  ]

  ;; ---- employed.csv : Sex,IMD,18,19,...,89  (% employed) ----
  ;; NOTE: in the supplied data, % employed is identical across all 5 IMD quintiles for a
  ;; given sex/age, so IMD is deliberately NOT modelled as an agent attribute yet -- this
  ;; lookup just keys on Sex+Age. If a future employed.csv varies by IMD, re-key this table
  ;; once quintiles.csv (P(IMD|age,sex)) is also added and an `imd` attribute exists.
  set employed-lookup table:make
  foreach but-first csv:from-file "employed.csv" [ row ->
    let s item 0 row
    let pcts sublist row 2 (length row)
    (foreach pcts (range 18 90) [ [pct a] -> table:put employed-lookup (word s "-" a) pct ])
  ]
end

to-report sample-sex
  let r random-float 1
  let cum 0
  foreach sex-probs [ pair ->
    set cum cum + (item 1 pair)
    if r <= cum [ report item 0 pair ]
  ]
  report item 0 last sex-probs
end

to-report sample-age [s]
  let dist ifelse-value (s = "Male") [ age-dist-male ] [ age-dist-female ]
  let r random-float 1
  let cum 0
  let idx 0
  foreach dist [ p ->
    set cum cum + p
    if r <= cum [ report 18 + idx ]
    set idx idx + 1
  ]
  report 89
end

to-report lookup-employed-pct [s a]
  let key (word s "-" a)
  ifelse table:has-key? employed-lookup key
    [ report table:get employed-lookup key ]
    [ report 0 ]
end

;; ================= SETUP =================

to setup
  clear-all
  set rewiring-events 0
  set death-count 0
  set new-residents-count 0
  set annual_inflow 10   ;; NEW -- default city inflow rate: 10 new adults/year. Edit this number directly.
  set city-capacity N_h * 5           ;; NEW -- ceiling = same max household size (5) x N_h households;
                                       ;;         edit directly, or scale it off N_h if you change N_h
  set monthly-outmigration-prob 0.0025  ;; NEW -- ~3%/year baseline turnover; typical range for city-level
                                       ;;         in/out migration -- edit directly to sweep as a parameter
  set out-migrant-count 0
  set t_lag_months t_lag_years * 12    ;; t_lag_years is a slider (default 5, per sourced value)
  load-parameters
  create-households
  set next-household-id N_h            ;; NEW -- household ids 0..N_h-1 are taken; new households start here
  assign-behaviours
  create-household-links
  create-initial-friendships
  update-risk-and-colors
  reset-ticks
end

to create-households
  let hh 0
  repeat N_h [
    let hh-size 1 + random 5              ;; Na in {1..5}, per toy-model spec
    let cx random-xcor
    let cy random-ycor
    repeat hh-size [
      create-people 1 [
        set household-id hh
        set sex sample-sex
        set age sample-age sex
        set age-months 0
        set employed? (random-float 100 < lookup-employed-pct sex age)
        set shape "person"
        set size 1.3
        setxy (cx + random-float 1.6 - 0.8) (cy + random-float 1.6 - 0.8)
      ]
    ]
    set hh hh + 1
  ]
end

to assign-behaviours
  ask people [
    set smoking-level random 3
    set alcohol-level random 3
    set diet-level random 3
    set inactivity-level random 3
    set smoking-level-months 0
    set alcohol-level-months 0
    set diet-level-months 0
    set inactivity-level-months 0
  ]
end

;; static, fully-connected within household
to create-household-links
  ask people [
    let me self
    ask other people with [household-id = [household-id] of me and who > [who] of me] [
      create-household-link-with me [ set color grey  set thickness 0.05 ]
    ]
  ]
end

;; initial random cross-household friendships, up to F_max
to create-initial-friendships
  ask people [
    let me self
    let slots F_max - count my-friend-links
    if slots > 0 [
      let candidates other people with [
        household-id != [household-id] of me and
        not friend-link-neighbor? me
      ]
      if any? candidates [
        let partners n-of (min (list slots count candidates)) candidates
        ask partners [
          if count my-friend-links < F_max [
            create-friend-link-with me [ set color sky  set thickness 0.03 ]
          ]
        ]
      ]
    ]
  ]
end

;; ================= GO =================

to go
  if not any? people [ stop ]
  if ticks mod gamma_behavior = 0 [ behaviour-update ]
  relapse-check                              ;; NEW -- p_relapse is a monthly hazard, so checked every tick
  if ticks mod gamma_net = 0      [ friendship-update ]
  update-risk-and-colors
  test-for-death                             ;; NEW -- QRISK3-lite baseline x behaviour RR x lag ramp
  check-out-migration                        ;; NEW -- monthly out-migration hazard (2nd exit route besides death)
  age-and-duration-up                        ;; NEW -- age (every 12 ticks) + level-duration counters
  if ticks > 0 and ticks mod 12 = 0 [ add-new-residents ]   ;; NEW -- annual inflow of 18+ adults (city renewal)
  tick
end

;; ---- 8. Out-migration (city churn) ----
;; A real city doesn't just lose people to death -- people also move away for jobs, family, or
;; retirement elsewhere. Without this, the only exit route is death, and since young inflow
;; agents have a near-zero CVD death probability, they never leave -- the population just
;; accumulates without limit. This gives every resident, regardless of age or health, a small
;; ongoing chance of leaving the city, so inflow has something to balance against.
to check-out-migration
  ask people [
    if random-float 1 < monthly-outmigration-prob [
      set out-migrant-count out-migrant-count + 1
      die
    ]
  ]
end

;; ---- 7. Population inflow (city renewal) ----
;; A real city is not a closed cohort: every year some residents turn 18 within existing
;; households, and others move into the city and form new households. Without this, the
;; model is a pure one-way attrition process -- with no births/in-migration and a non-zero
;; monthly death hazard for every agent, the population is mathematically guaranteed to hit
;; zero if you run it for long enough. This procedure keeps the city "alive" the way a real
;; settlement is: a churn of inflow and outflow, not a single ageing cohort running out.
;;
;; annual_inflow (global, default 10, set in setup) = expected number of new adults added per
;; year. Actual number drawn from a Poisson distribution around that mean, so year-to-year inflow isn't perfectly constant.
;; existing-household-join-prob = share of newcomers who join an under-capacity existing
;; household (a child of that household turning 18) vs. forming a brand-new household
;; (in-migration to the city). Kept as a hardcoded constant for now -- promote to a slider if
;; you want to sweep it as an experimental parameter.
to add-new-residents
  let existing-household-join-prob 0.3
  let room city-capacity - count people
  if room <= 0 [ stop ]                          ;; NEW -- city is at capacity, no inflow this year
  let n-new min (list (random-poisson annual_inflow) room)   ;; NEW -- never overshoot the ceiling
  repeat n-new [
    ifelse (random-float 1 < existing-household-join-prob) and
           any? people with [count my-household-links + 1 < 5]
    [
      ;; --- joins an existing under-capacity household, e.g. a child turning 18 ---
      let host one-of people with [count my-household-links + 1 < 5]
      let hh [household-id] of host
      let hx [xcor] of host
      let hy [ycor] of host
      create-people 1 [
        set household-id hh
        set sex sample-sex
        set age 18
        set age-months 0
        set employed? (random-float 100 < lookup-employed-pct sex age)
        set shape "person"
        set size 1.3
        setxy (hx + random-float 1.6 - 0.8) (hy + random-float 1.6 - 0.8)
        set smoking-level random 3
        set alcohol-level random 3
        set diet-level random 3
        set inactivity-level random 3
        set smoking-level-months 0
        set alcohol-level-months 0
        set diet-level-months 0
        set inactivity-level-months 0
        let me self
        ask other people with [household-id = hh] [
          create-household-link-with me [ set color grey  set thickness 0.05 ]
        ]
      ]
    ]
    [
      ;; --- forms a brand-new household (in-migration to the city) ---
      let hh next-household-id
      set next-household-id next-household-id + 1
      let hh-size 1 + random 3     ;; new-arrival households skew smaller than setup's 1-5 range
      let cx random-xcor
      let cy random-ycor
      repeat hh-size [
        create-people 1 [
          set household-id hh
          set sex sample-sex
          set age 18
          set age-months 0
          set employed? (random-float 100 < lookup-employed-pct sex age)
          set shape "person"
          set size 1.3
          setxy (cx + random-float 1.6 - 0.8) (cy + random-float 1.6 - 0.8)
          set smoking-level random 3
          set alcohol-level random 3
          set diet-level random 3
          set inactivity-level random 3
          set smoking-level-months 0
          set alcohol-level-months 0
          set diet-level-months 0
          set inactivity-level-months 0
        ]
      ]
      ask people with [household-id = hh] [
        let me self
        ask other people with [household-id = hh and who > [who] of me] [
          create-household-link-with me [ set color grey  set thickness 0.05 ]
        ]
      ]
    ]
    set new-residents-count new-residents-count + 1
  ]
  ;; give newcomers a starting set of cross-household friendships too, same rule as setup
  create-initial-friendships
end

;; ---- 1. Behaviour Update Rule ----
;; household influence > friend influence (matching paper hierarchy)
to behaviour-update
  ask people [
    update-one-behaviour "smoking"
    update-one-behaviour "alcohol"
    update-one-behaviour "diet"
    update-one-behaviour "inactivity"
  ]
end

to update-one-behaviour [b]
  let hh-levels []
  let fr-levels []
  ask household-link-neighbors [ set hh-levels lput (get-level b) hh-levels ]
  ask friend-link-neighbors    [ set fr-levels lput (get-level b) fr-levels ]

  let hh-mean ifelse-value (empty? hh-levels) [ -1 ] [ mean hh-levels ]
  let fr-mean ifelse-value (empty? fr-levels) [ -1 ] [ mean fr-levels ]

  let w-h influence_weight_household
  ;; beta_peer (sourced "how much influence friends have on a person's behaviour", 0.25-0.33
  ;; range) is mapped onto influence_weight_friend per the D.2 reinterpretation -- the 0.4
  ;; change-trigger gap below is left as a separate, still-unsourced parameter.
  let w-f influence_weight_friend
  let w-a omega_age    ;; NEW -- weight on the age-driven pull, see age-target below for sourcing
  let age-mean age-target b age    ;; NEW -- age-driven pull, always defined (no -1 case needed)

  let total-w 0
  let weighted-sum 0
  if hh-mean >= 0 [ set total-w total-w + w-h  set weighted-sum weighted-sum + w-h * hh-mean ]
  if fr-mean >= 0 [ set total-w total-w + w-f  set weighted-sum weighted-sum + w-f * fr-mean ]
  if w-a > 0      [ set total-w total-w + w-a  set weighted-sum weighted-sum + w-a * age-mean ]   ;; NEW

  if total-w > 0 [
    let target weighted-sum / total-w
    let current get-level b
    let new-level current
    if target > current + 0.4 [ set new-level min (list 2 (current + 1)) ]
    if target < current - 0.4 [ set new-level max (list 0 (current - 1)) ]

    ;; special rule: never-smoked (level 0) can never be regained
    ifelse b = "smoking" [
      if not (new-level = 0 and current > 0) [ set-level b new-level ]
    ] [
      set-level b new-level
    ]
  ]
end

to-report get-level [b]
  if b = "smoking"    [ report smoking-level ]
  if b = "alcohol"    [ report alcohol-level ]
  if b = "diet"       [ report diet-level ]
  if b = "inactivity" [ report inactivity-level ]
  report 0
end

to set-level [b v]
  let old get-level b
  if b = "smoking"    [ set smoking-level v      if v != old [ set smoking-level-months 0 ] ]
  if b = "alcohol"    [ set alcohol-level v      if v != old [ set alcohol-level-months 0 ] ]
  if b = "diet"       [ set diet-level v         if v != old [ set diet-level-months 0 ] ]
  if b = "inactivity" [ set inactivity-level v   if v != old [ set inactivity-level-months 0 ] ]
end

;; ---- 2. Friendship Adaptation Rule ----
;; (dynamic-relationship idea adapted from DynamiX's homophily-based
;;  follow/unfollow mechanism, simplified for a toy ABM)
to friendship-update
  ;; (a) evaluate existing friendships: mismatch > theta_tol -> probabilistic removal
  ask people [
    let me self
    ask my-friend-links [
      let other-person other-end
      let mismatch behaviour-mismatch me other-person
      if mismatch > theta_tol [
        let removal-prob (mismatch - theta_tol) / (8 - theta_tol + 0.0001)
        if random-float 1 < removal-prob [
          die
          set rewiring-events rewiring-events + 1
        ]
      ]
    ]
  ]

  ;; (b) if below F_max, seek a new friend from another household by homophily
  ask people [
    let me self
    if count my-friend-links < F_max [
      let candidates other people with [
        household-id != [household-id] of me and
        not friend-link-neighbor? me
      ]
      if any? candidates [
        let best min-one-of candidates [ behaviour-mismatch me self ]
        if best != nobody [
          if count [my-friend-links] of best < F_max [
            create-friend-link-with best [ set color sky  set thickness 0.03 ]
            set rewiring-events rewiring-events + 1
          ]
        ]
      ]
    ]
  ]
end

to-report behaviour-mismatch [a b]
  report (abs ([smoking-level] of a - [smoking-level] of b) +
          abs ([alcohol-level] of a - [alcohol-level] of b) +
          abs ([diet-level] of a - [diet-level] of b) +
          abs ([inactivity-level] of a - [inactivity-level] of b))
end

to-report get-level-months [b]
  if b = "smoking"    [ report smoking-level-months ]
  if b = "alcohol"    [ report alcohol-level-months ]
  if b = "diet"       [ report diet-level-months ]
  if b = "inactivity" [ report inactivity-level-months ]
  report 0
end

;; ---- 3. Relapse Rule ----
;; p_relapse (sourced: 0.05/month) is an INDEPENDENT stochastic hazard, separate from the
;; deterministic weighted-average pull in update-one-behaviour. It only fires for an agent who
;; is NOT already at the riskiest level (2), and only when a majority (>= relapse_friend_threshold)
;; of their friends are still at the riskiest level -- i.e. "quit, but surrounded by the habit".
;; Checked every tick (not gated by gamma_behavior) since p_relapse is itself a per-month rate.
to relapse-check
  ask people [
    relapse-one-behaviour "smoking"
    relapse-one-behaviour "alcohol"
    relapse-one-behaviour "diet"
    relapse-one-behaviour "inactivity"
  ]
end

to relapse-one-behaviour [b]
  let current get-level b
  if current < 2 [
    let fr-levels []
    ask friend-link-neighbors [ set fr-levels lput (get-level b) fr-levels ]
    if not empty? fr-levels [
      let frac-high (length filter [ l -> l = 2 ] fr-levels) / (length fr-levels)
      if frac-high >= relapse_friend_threshold [
        if random-float 1 < p_relapse [
          ;; smoking level-0 ("never smoked") irreversibility rule is preserved: relapse cannot
          ;; move a never-smoker to level 1 -- only agents already at level 1 (ex-smoker) can
          ;; relapse to level 2, matching real "quit, then relapse" semantics
          if not (b = "smoking" and current = 0) [
            set-level b (current + 1)
          ]
        ]
      ]
    ]
  ]
end

;; ---- 4. CVD Risk Model ----
;; Baseline R0(age,sex): exact simplified-QRISK3 formulation reused from the base paper
;; (Archbold et al. 2024, agent.py base_cvd_male/base_cvd_female), with the same fixed
;; population-default BMI/cholesterol-ratio/SBP/SBP-variability constants. Source:
;; Hippisley-Cox et al. (2017), BMJ. Returns a 10-YEAR probability (0-1).
to-report base-cvd-female [a]
  let bmi 26.8   let rati 3.5   let sbp 123   let sbps5 5
  let dage a / 10.0
  let age_1 (dage ^ -2) - 0.053274843841791
  let age_2 dage - 4.332503318786621
  let dbmi bmi / 10.0
  let bmi_1 (dbmi ^ -2) - 0.154946178197861
  let bmi_2 ((dbmi ^ -2) * (ln dbmi)) - 0.144462317228317
  let rati2 rati - 3.476326465606690
  let sbp2 sbp - 123.130012512207030
  let sbps52 sbps5 - 9.002537727355957
  let a-sum 0
  set a-sum a-sum + age_1 * -8.1388109247726188
  set a-sum a-sum + age_2 * 0.7973337668969909800
  set a-sum a-sum + bmi_1 * 0.2923609227546005200
  set a-sum a-sum + bmi_2 * -4.1513300213837665
  set a-sum a-sum + rati2 * 0.1533803582080255400
  set a-sum a-sum + sbp2 * 0.0131314884071034240
  set a-sum a-sum + sbps52 * 0.0078894541014586095
  set a-sum a-sum + age_1 * bmi_1 * 23.8026234121417420
  set a-sum a-sum + age_1 * bmi_2 * -71.1849476920870070
  set a-sum a-sum + age_1 * sbp2 * 0.0341318423386154850
  set a-sum a-sum + age_2 * bmi_1 * 0.5236995893366442900
  set a-sum a-sum + age_2 * bmi_2 * 0.0457441901223237590
  set a-sum a-sum + age_2 * sbp2 * -0.0015082501423272358
  let score 100 * (1 - (0.988876402378082 ^ (exp a-sum)))
  report score / 100
end

to-report base-cvd-male [a]
  let bmi 27.7   let rati 4.1   let sbp 130   let sbps5 7
  let dage a / 10.0
  let age_1 (dage ^ -1) - 0.234766781330109
  let age_2 (dage ^ 3) - 77.284080505371094
  let dbmi bmi / 10.0
  let bmi_1 (dbmi ^ -2) - 0.149176135659218
  let bmi_2 ((dbmi ^ -2) * (ln dbmi)) - 0.141913309693336
  let rati2 rati - 4.300998687744141
  let sbp2 sbp - 128.571578979492190
  let sbps52 sbps5 - 8.756621360778809
  let a-sum 0
  set a-sum a-sum + age_1 * -17.8397816660055750
  set a-sum a-sum + age_2 * 0.0022964880605765492
  set a-sum a-sum + bmi_1 * 2.4562776660536358
  set a-sum a-sum + bmi_2 * -8.3011122314711354
  set a-sum a-sum + rati2 * 0.1734019685632711100
  set a-sum a-sum + sbp2 * 0.0129101265425533050
  set a-sum a-sum + sbps52 * 0.0102519142912904560
  set a-sum a-sum + age_1 * bmi_1 * 31.0049529560338860
  set a-sum a-sum + age_1 * bmi_2 * -111.2915718439164300
  set a-sum a-sum + age_1 * sbp2 * 0.0188585244698658530
  set a-sum a-sum + age_2 * bmi_1 * 0.0050380102356322029
  set a-sum a-sum + age_2 * bmi_2 * -0.0130744830025243190
  set a-sum a-sum + age_2 * sbp2 * -0.0000127187419158845700
  let score 100 * (1 - (0.977268040180206 ^ (exp a-sum)))
  report score / 100
end

;; Relative-risk lookup tables. Each returns a multiplier for a given ordinal level (0/1/2).
;; STATUS is marked per table -- see Part D / D.2 of the parameter documentation for full sourcing.
to-report rr-smoke [lvl]
  ;; SOURCED (dose-mapped: level 2 = "20 cigarettes/day" RR, the heavier/upper-bound figure).
  ;; Level 1 (ex-smoker) is PROVISIONAL -- still needs Mons et al. (2015) cessation-risk figure.
  if lvl = 0 [ report 1.0 ]
  if lvl = 1 [ report ifelse-value (sex = "Male") [ 1.3 ] [ 1.4 ] ]   ;; PROVISIONAL
  report ifelse-value (sex = "Male") [ 2.27 ] [ 3.95 ]                 ;; SOURCED
end

to-report rr-alcohol [lvl]
  ;; The sourced J-shaped table (regular heavy 0.75 / binge 1.10 / protective dose 0.85) maps
  ;; awkwardly onto 3 ordinal levels and makes the RISKIEST level look "protective" if used as-is.
  ;; DEFAULT below is a monotonic fallback (PROVISIONAL magnitudes). The J-shaped Track-B
  ;; alternative is left commented out -- swap the two blocks to run that robustness scenario.
  if lvl = 0 [ report 1.0 ]
  if lvl = 1 [ report 1.3 ]
  report 1.6
  ;; ---- Track B (J-shaped, as sourced) -- comment out the block above and uncomment this ----
  ;; if lvl = 0 [ report 0.85 ]
  ;; if lvl = 1 [ report 1.10 ]
  ;; report 0.75
end

to-report rr-diet [lvl]
  ;; PROVISIONAL composite. Sourced GBD table gives 5 separate nutrient risk factors, not yet
  ;; collapsed into one number -- direction/ordering is sourced, magnitudes are illustrative.
  if lvl = 0 [ report 1.0 ]
  if lvl = 1 [ report 1.15 ]
  report 1.3
end

to-report rr-activity [lvl]
  ;; PARTIALLY SOURCED -- only the upper bound is known (RRactivity < 1.5). Level breakdown below
  ;; is illustrative and should be revisited once a level-by-level source is found.
  if lvl = 0 [ report 1.0 ]
  if lvl = 1 [ report 1.2 ]
  report 1.45
end

;; Lag Time (t_lag, sourced = 5 years): a behaviour's RR ramps linearly from neutral (1x) to
;; full strength over t_lag_months, rather than applying instantly -- covers both onset of
;; elevated risk AND the gradual fall in risk after adopting a healthier level (since
;; set-level resets the duration counter to 0 on ANY change, the ramp restarts either way).
;; ---- Age Effect (omega_age) ----
;; behaviour_cvd_prevalence.csv (the base paper's actual age x sex x behaviour-level prevalence
;; table) was never supplied, so this is NOT that file. Instead it's built from real, cited
;; ONS/NHS Digital (Health Survey for England) and Sport England Active Lives published
;; statistics on how each behaviour's prevalence varies by age band. Each age-target below is a
;; 0-2 "typical level for this age" pull, min-max scaled from the cited real prevalence figures
;; -- the DIRECTION and RELATIVE ordering across age bands is sourced; the exact numeric levels
;; are an illustrative proxy standing in for the real per-level prevalence table, same status as
;; the other PROVISIONAL entries in the RR tables above. Replace with behaviour_cvd_prevalence.csv
;; -derived values if/when that file becomes available.
to-report age-target [b a]
  if b = "smoking" [
    ;; ONS (2021): current-smoker prevalence peaks at 25-34 (~20%), falls steadily with age,
    ;; lowest at 65+ (~5.5-8%)
    if a < 25  [ report 1.0 ]
    if a < 35  [ report 1.3 ]
    if a < 45  [ report 1.0 ]
    if a < 55  [ report 0.9 ]
    if a < 65  [ report 0.7 ]
    if a < 75  [ report 0.5 ]
    if a < 85  [ report 0.3 ]
    report 0.2
  ]
  if b = "alcohol" [
    ;; HSE / Commons Library: proportion drinking >14 units/week rises through mid-life,
    ;; peaks at 55-64 (~28-32%), lower among under-25s (~15-17%) and over-75s
    if a < 25  [ report 0.8 ]
    if a < 35  [ report 1.0 ]
    if a < 45  [ report 1.1 ]
    if a < 55  [ report 1.2 ]
    if a < 65  [ report 1.4 ]
    if a < 75  [ report 1.2 ]
    if a < 85  [ report 0.8 ]
    report 0.6
  ]
  if b = "diet" [
    ;; HSE / NDNS: under-25s eat fewest portions of fruit/veg (~3.0-3.3/day, ~22-23% hit
    ;; 5-a-day); 65-74 eat the most (~3.7/day); slight decline again at 75+ (~3.6/day)
    if a < 25  [ report 1.3 ]
    if a < 35  [ report 1.1 ]
    if a < 45  [ report 1.0 ]
    if a < 55  [ report 0.9 ]
    if a < 65  [ report 0.8 ]
    if a < 75  [ report 0.6 ]
    if a < 85  [ report 0.7 ]
    report 0.9
  ]
  ;; inactivity
  ;; Sport England Active Lives: inactivity rises steadily with age -- ~29% overall,
  ;; ~38.5% at 55-64, ~39.9% at 65-74, ~56.9% at 75-84, ~78.4% at 85+
  if a < 25  [ report 0.6 ]
  if a < 35  [ report 0.7 ]
  if a < 45  [ report 0.8 ]
  if a < 55  [ report 0.9 ]
  if a < 65  [ report 1.1 ]
  if a < 75  [ report 1.2 ]
  if a < 85  [ report 1.7 ]
  report 2.0
end

to-report lag-ramp [months-at-level]
  report min (list 1 (months-at-level / t_lag_months))
end

to-report effective-rr [b lvl months-at-level]
  let full-rr 1
  if b = "smoking"    [ set full-rr rr-smoke lvl ]
  if b = "alcohol"    [ set full-rr rr-alcohol lvl ]
  if b = "diet"       [ set full-rr rr-diet lvl ]
  if b = "inactivity" [ set full-rr rr-activity lvl ]
  report 1 + (full-rr - 1) * (lag-ramp months-at-level)
end

;; ---- 5. Death (CVD event) ----
;; Combines the QRISK3-lite 10-year baseline (converted to a monthly probability, since
;; 1 tick = 1 month) with the lag-ramped RR product across all 4 behaviours. On a positive
;; draw the agent is removed with NetLogo's `die` -- this automatically drops all of that
;; agent's household-links and friend-links too, so no manual list clean-up is needed (unlike
;; the base paper's Python agent_death(), which has to manually strip references).
to test-for-death
  ask people [
    let base10 ifelse-value (sex = "Male") [ base-cvd-male age ] [ base-cvd-female age ]

    ;; convert 10-year cumulative probability -> constant annual hazard rate
    ;; (proper survival-analysis conversion, avoids linear-division bias)
    let base10-clamped min (list base10 0.999999)   ;; guard against ln(0) if base10 ever hits 1
    let lambda-annual (- (ln (1 - base10-clamped))) / 10

    let rr (effective-rr "smoking"    smoking-level    smoking-level-months) *
            (effective-rr "alcohol"    alcohol-level    alcohol-level-months) *
            (effective-rr "diet"       diet-level       diet-level-months) *
            (effective-rr "inactivity" inactivity-level inactivity-level-months)

    ;; RR multiplies the hazard rate (correct interpretation of a relative risk),
    ;; then convert the effective annual hazard down to a monthly probability
    let lambda-effective lambda-annual * rr
    let monthly-p 1 - exp (- lambda-effective / 12)

    if random-float 1 < monthly-p [
      set death-count death-count + 1
      die
    ]
  ]
end

;; ---- 6. Ageing & duration tracking ----
to age-and-duration-up
  ask people [
    set age-months age-months + 1
    if age-months >= 12 [ set age age + 1  set age-months 0 ]
    set smoking-level-months smoking-level-months + 1
    set alcohol-level-months alcohol-level-months + 1
    set diet-level-months diet-level-months + 1
    set inactivity-level-months inactivity-level-months + 1
  ]
end

;; ================= RISK & COLOUR =================

to update-risk-and-colors
  ask people [
    set risk-score (smoking-level + alcohol-level + diet-level + inactivity-level)
    set color risk-colour risk-score
  ]
end

to-report risk-colour [r]
  if r <= 2 [ report green ]
  if r <= 4 [ report yellow ]
  if r <= 6 [ report orange ]
  report red
end

;; ================= MONITOR / PLOT REPORTERS =================
;; names match NETLOGO_SETUP_GUIDE.md exactly

to-report report-total-agents
  report count people
end

to-report report-mean-risk
  report ifelse-value (any? people) [ mean [risk-score] of people ] [ 0 ]
end

to-report report-mean-friends
  report ifelse-value (any? people) [ mean [count my-friend-links] of people ] [ 0 ]
end

to-report total-friend-links
  report count friend-links
end

to-report total-household-links
  report count household-links
end

to-report report-rewiring-events
  report rewiring-events
end

to-report report-pct-high-smoking
  report 100 * (count people with [smoking-level = 2]) / (max list 1 count people)
end

to-report report-pct-high-alcohol
  report 100 * (count people with [alcohol-level = 2]) / (max list 1 count people)
end

to-report report-pct-high-diet
  report 100 * (count people with [diet-level = 2]) / (max list 1 count people)
end

to-report report-pct-high-inactivity
  report 100 * (count people with [inactivity-level = 2]) / (max list 1 count people)
end

to-report report-mean-age
  report ifelse-value (any? people) [ mean [age] of people ] [ 0 ]
end

to-report report-pct-employed
  report 100 * (count people with [employed?]) / (max list 1 count people)
end

to-report report-deaths
  report death-count
end

to-report report-new-residents
  report new-residents-count
end

to-report report-out-migrants
  report out-migrant-count
end

to-report report-city-capacity
  report city-capacity
end]]></code>
